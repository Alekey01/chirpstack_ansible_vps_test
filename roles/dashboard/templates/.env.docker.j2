{# .env.docker para el dashboard. Generado por Ansible — NO editar a mano en el VPS. #}
# ── PostgreSQL (contenedor del dashboard) ─────────────────────────
PORT={{ dashboard_port }}
PG_PORT=5432
PG_DB={{ dashboard_pg_db }}
PG_USER={{ dashboard_pg_user }}
PG_PASS="{{ vault_dashboard_pg_password }}"

POSTGRES_DB={{ dashboard_pg_db }}
POSTGRES_USER={{ dashboard_pg_user }}
POSTGRES_PASSWORD="{{ vault_dashboard_pg_password }}"

# ── ChirpStack del host ───────────────────────────────────────────
GATEWAY_ID={{ vault_dashboard_gateway_id }}
CHIRPSTACK_KEY={{ vault_dashboard_chirpstack_jwt }}
