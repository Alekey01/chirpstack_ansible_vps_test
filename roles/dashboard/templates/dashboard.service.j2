{# Unit systemd para el dashboard (baremetal con Bun). Renderizada por Ansible. #}
[Unit]
Description=Cuby LoRaWAN Dashboard (Bun)
Documentation=https://github.com/Alekey01/Dashboard_Cuby_LoRaWAN
After=network-online.target postgresql.service mosquitto.service chirpstack.service
Wants=network-online.target
# Si Postgres no está, no tiene sentido arrancar.
Requires=postgresql.service

[Service]
Type=simple
User={{ dashboard_service_user }}
Group={{ dashboard_service_group }}
# Backend vive en {{ dashboard_backend_dir }} (monorepo: backend/ + frontend/).
WorkingDirectory={{ dashboard_backend_dir }}
# Lee .env del raíz del repo (donde Ansible lo renderiza). systemd lo inyecta
# como variables de entorno reales, así que da igual la CWD del proceso.
EnvironmentFile={{ dashboard_install_dir }}/.env
ExecStart={{ dashboard_start_command }}
Restart=on-failure
RestartSec=5s
# Endurecimiento básico — no estrictamente necesario, pero buena higiene.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
