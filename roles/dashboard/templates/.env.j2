{# .env del dashboard (baremetal). Generado por Ansible — NO editar a mano. #}
# ── Backend ───────────────────────────────────────────────────────
PORT={{ dashboard_port }}
NODE_ENV=production

# ── PostgreSQL (instancia del sistema, no contenedor) ─────────────
PG_HOST={{ dashboard_pg_host }}
PG_PORT={{ dashboard_pg_port }}
PG_DB={{ dashboard_pg_db }}
PG_USER={{ dashboard_pg_user }}
PG_PASS="{{ vault_dashboard_pg_password }}"

# Algunos forks del repo siguen leyendo POSTGRES_*. Las duplicamos
# para no romper compatibilidad.
POSTGRES_HOST={{ dashboard_pg_host }}
POSTGRES_PORT={{ dashboard_pg_port }}
POSTGRES_DB={{ dashboard_pg_db }}
POSTGRES_USER={{ dashboard_pg_user }}
POSTGRES_PASSWORD="{{ vault_dashboard_pg_password }}"

# ── ChirpStack del host ───────────────────────────────────────────
CHIRPSTACK_API={{ dashboard_chirpstack_api }}
MQTT_BROKER={{ dashboard_mqtt_broker }}
GATEWAY_ID={{ vault_dashboard_gateway_id }}
CHIRPSTACK_KEY={{ vault_dashboard_chirpstack_jwt }}
