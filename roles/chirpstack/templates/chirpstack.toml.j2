{#
  Plantilla del fichero principal de configuración de ChirpStack v4.
  Destino: /etc/chirpstack/chirpstack.toml
  Generado por Ansible. NO editar a mano.
#}
# Configuración de ChirpStack v4 (gestionada por Ansible).
# Rol: roles/chirpstack

[logging]
  level = "info"
  log_to_syslog = false

# ── PostgreSQL ───────────────────────────────────────────────────────────────
[postgresql]
  dsn = "postgres://{{ postgresql_db_user }}:{{ postgresql_db_password }}@localhost/{{ postgresql_db_name }}?sslmode=disable"
  max_open_connections = 10
  min_idle_connections = 0

# ── Redis ────────────────────────────────────────────────────────────────────
[redis]
  servers = ["redis://localhost/"]
  cluster = false

# ── Red LoRaWAN ──────────────────────────────────────────────────────────────
[network]
  net_id = "000000"
  enabled_regions = ["{{ chirpstack_region }}"]

# ── API (UI web + gRPC) ──────────────────────────────────────────────────────
# Bind a 127.0.0.1 porque nginx (puerto 80) hace de reverse proxy delante.
# Si quitas nginx, cambia chirpstack_bind_address a 0.0.0.0 en group_vars.
[api]
  bind = "{{ chirpstack_bind_address }}:{{ chirpstack_puerto_web }}"
  secret = "{{ chirpstack_api_secret }}"

# ── Conexión al broker MQTT (donde escucha el gateway-bridge) ────────────────
[gateway]

[gateway.backend]
  enabled = "mqtt"

[gateway.backend.mqtt]
  server = "tcp://localhost:1883"
  username = ""
  password = ""
  qos = 0
  clean_session = true

# ── Integración MQTT global ──────────────────────────────────────────────────
# Re-publica los eventos de aplicación (uplinks, joins, ack, status, location,
# txack…) al broker MQTT local en los topics estándar de ChirpStack v4.
# Sin esta sección, ChirpStack procesa los uplinks internamente pero NO los
# emite a MQTT — cualquier consumidor/integración externa (suscrito a
# `application/+/...`) se quedaría sin datos.
[integration]
  enabled = ["mqtt"]

[integration.mqtt]
  {# Las {{...}} de abajo son sintaxis de plantilla de ChirpStack, no de Jinja. #}
  event_topic_template   = {% raw %}"application/{{application_id}}/device/{{dev_eui}}/event/{{event}}"{% endraw %}

  command_topic_template = {% raw %}"application/{{application_id}}/device/{{dev_eui}}/command/{{command}}"{% endraw %}

  server   = "tcp://localhost:1883"
  username = ""
  password = ""
  qos      = 0
